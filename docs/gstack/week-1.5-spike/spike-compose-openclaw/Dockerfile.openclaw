# OpenClaw Gateway container.
#
# Install path is `npm install -g openclaw@<version>` per
# docs.openclaw.ai/install/installer. The install.sh wrapper is for laptops;
# we want a deterministic npm install for reproducible Docker builds.

ARG OPENCLAW_VERSION=2026.5.20

# Node 24 is OpenClaw's default per docs/install/installer; Node 22.19+ supported.
FROM node:24-bookworm-slim AS base

# ─── System deps ───────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    git ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*

# Avoid sharp building against system libvips — per docs, OpenClaw installer
# defaults this. We match for parity.
ENV SHARP_IGNORE_GLOBAL_LIBVIPS=1

# ─── OpenClaw ──────────────────────────────────────────────────────────────
ARG OPENCLAW_VERSION
RUN npm install -g openclaw@${OPENCLAW_VERSION} && openclaw --version

# OpenClaw emits gen_ai.* spans natively via its `diagnostics-otel` plugin
# (see docs/gateway/opentelemetry.md inside the package). The generic
# @opentelemetry/auto-instrumentations-node bundle only ships HTTP/dns/undici
# instrumentations — it does not produce gen_ai semantic-convention spans for
# Anthropic, so we rely on OpenClaw's first-party plugin instead.
RUN openclaw plugins install clawhub:@openclaw/diagnostics-otel --pin

# cbcoutinho/nextcloud-mcp-server is the EM's + Researcher's outbound MCP for
# Talk and Notes. Stdio transport (uvx-launched at runtime), so we just need
# the uv binary on PATH — uv handles the Python venv per invocation.
#
# (We deliberately do NOT install the @openclaw/nextcloud-talk channel plugin.
# That plugin is single-bot-identity; per-agent identity in Roster requires
# each agent to write through its own Nextcloud user, which is what cbcoutinho
# via stdio gives us. See t5-run-1prime-conclusions.md for the architecture
# discussion.)
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_UNMANAGED_INSTALL=/usr/local/bin sh

# ─── Workspace ─────────────────────────────────────────────────────────────
WORKDIR /workspace
VOLUME ["/workspace", "/root/.openclaw"]

EXPOSE 18789

# Gateway runs in foreground. Container lifecycle = Gateway lifecycle.
ENTRYPOINT ["openclaw", "gateway", "--port", "18789"]
