// Apples-to-apples cost + cache-hit comparison between routes. Unifies:
//   • OpenRouter Broadcast events (Run 1 data; route=openrouter)
//   • Anthropic-native OTel events (Run 1-anthropic-direct + Run 2; route=anthropic-native)
//
// Adjust the OpenRouter branch's field names to whatever your Broadcast →
// OTel mapping currently emits — the comments below assume the common
// shape (broadcast event name = "openrouter.chat.completion", usage fields
// on customDimensions).
//
// Field-name note (verified 2026-05-23): the Anthropic-native side comes
// from opentelemetry-instrumentation-anthropic, which emits the LEGACY
// `gen_ai.usage.prompt_tokens` / `gen_ai.usage.completion_tokens` keys
// (not the newer `input_tokens` / `output_tokens`). Group by `cloud_RoleName`
// rather than `agent_role` so spans whose customDimensions JSON was
// truncated at App Insights' 64KB limit still aggregate (see kql/01).

let anthropic_native =
    dependencies
    | where name == "anthropic.chat"
    | extend
        route = "anthropic-native",
        service = cloud_RoleName,
        prompt_tokens     = tolong(customDimensions["gen_ai.usage.prompt_tokens"]),
        completion_tokens = tolong(customDimensions["gen_ai.usage.completion_tokens"]),
        cache_read        = tolong(customDimensions["gen_ai.usage.cache_read_input_tokens"]),
        cache_write       = tolong(customDimensions["gen_ai.usage.cache_creation_input_tokens"]);
let openrouter =
    dependencies
    | where name startswith "openrouter" or customDimensions["gen_ai.system"] == "openrouter"
    | extend
        route = "openrouter",
        service = cloud_RoleName,
        prompt_tokens     = tolong(customDimensions["prompt_tokens"]),
        completion_tokens = tolong(customDimensions["completion_tokens"]),
        cache_read        = tolong(customDimensions["native_tokens_cached"]),
        cache_write       = tolong(0);  // OpenRouter Broadcast does not split out cache writes
union anthropic_native, openrouter
| where timestamp > ago(24h)
| extend
    cache_read  = coalesce(cache_read, 0),
    cache_write = coalesce(cache_write, 0)
| extend
    billable_input = prompt_tokens - cache_read - cache_write,    // tokens charged at full input rate
    cache_hit_pct  = iff(prompt_tokens > 0,
                         round(100.0 * cache_read / prompt_tokens, 1),
                         0.0)
| summarize
    reqs              = count(),
    total_prompt      = sum(prompt_tokens),
    total_cache_read  = sum(cache_read),
    total_cache_write = sum(cache_write),
    total_output      = sum(completion_tokens),
    avg_cache_hit_pct = avg(cache_hit_pct),
    p50_latency_ms    = percentile(duration, 50),
    p95_latency_ms    = percentile(duration, 95)
    by route, service
| order by route asc, service asc
