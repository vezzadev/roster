# driver.py spike-time relay runtime files (state file is also matched by *.local
# at the repo root, but be explicit here so it's clear).
driver.log
driver.log.*
driver.stdout
driver-state.local
# Kickoff bookkeeping files
kickoff-timestamp.local
run1-kickoff-response.local
run1-followup-response.local
# Timestamped backups of .local files (e.g. when swapping agent registries between
# routes). *.local matches the base name at the repo root, but not these suffixes.
*.local.*
# Exception: committed schema documentation for *.local config files (rooms.local
# is gitignored, rooms.local.example is checked in for operators to copy).
!*.local.example
