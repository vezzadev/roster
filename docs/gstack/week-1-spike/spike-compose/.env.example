# Copy to .env, fill values, chmod 600 .env. NEVER commit .env.
# Compose uses :? required-variable references — missing values fail at
# `./bring-up.sh up`.
#
# The two sensitive credentials live OUTSIDE this file, in:
#   ./openrouter.local   — raw OpenRouter API key, one line
#   ./letta.local        — raw Letta server token, one line
# Both are gitignored repo-wide via *.local at the repo root.
# bring-up.sh loads them into env before invoking docker compose.

# Nextcloud database (Postgres role + password — locally significant only)
NC_DB_PASSWORD=

# Nextcloud admin user (founder uses this; NOT an agent identity)
NC_ADMIN_USER=admin
NC_ADMIN_PASSWORD=
